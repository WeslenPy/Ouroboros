# Copie para .env. Nunca commite o .env.
OUROBOROS_DATABASE_URL=postgresql+asyncpg://ouroboros:ouroboros@localhost:5433/ouroboros
OUROBOROS_LOG_LEVEL=INFO
# OUROBOROS_RAW_DIR=../data/raw

# Chave do HMAC de CPF. Gere uma aleatória: python -c "import secrets;print(secrets.token_hex(32))"
# Trocar depois exige reprocessar as fontes.
# OUROBOROS_HASH_KEY=

# Chave gratuita: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
OUROBOROS_TRANSPARENCIA_API_KEY=

# Banco de testes de integração (pytest pula se ausente). Use um banco descartável.
# OUROBOROS_TEST_DATABASE_URL=postgresql+asyncpg://ouroboros:ouroboros@localhost:5433/ouroboros_test
